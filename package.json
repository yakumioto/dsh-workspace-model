{
  "name": "@yakumioto/dsh-workspace-model",
  "version": "0.1.0",
  "description": "Per-workspace default model for DeepSeek Harness: new sessions in a workspace start from its own model, unset workspaces keep the deployment default",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node test/unit.mjs && node test/client.mjs && node test/manifest.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check": "node --check lib/index.js && node --check client/client.js && npm test && npm run typecheck"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakumioto/dsh-workspace-model.git"
  },
  "homepage": "https://github.com/yakumioto/dsh-workspace-model",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "workspace",
    "model",
    "default-model"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
